# Copiar a "docker/.env" y completar. No se sube a Git (cubierto por la regla ".env" del
# .gitignore raiz). Usar credenciales de PRUEBA aqui, no las de produccion.
DB_NAME=monit_srv
DB_USER=qua_admin
DB_PASSWORD=cambiar_esto

# uid:gid del usuario del host que es dueno de inventario_servidores.yaml, .env, etc. (y que va a
# correr el contenedor). Por defecto 1000 (el de "quantum" en la mayoria de los servidores) -- si
# el usuario real tiene otro uid/gid (ej. una cuenta personal como "imedina"), hay que ponerlo
# aqui, o el contenedor no podra leer esos archivos. Verificar con: id <usuario>
HOST_UID=1000
HOST_GID=1000

# IP del host donde se publica el dashboard, ademas de 127.0.0.1 (siempre incluido). Vacio o
# ausente = solo loopback. Usar una IP literal conocida del host (ej. la de ZeroTier), nunca
# 0.0.0.0 -- ufw/iptables no filtra puertos publicados por Docker (DNAT en PREROUTING, antes de
# INPUT), asi que 0.0.0.0 aqui expondria el dashboard a toda la red sin que el firewall lo note.
BIND_IP=127.0.0.1
