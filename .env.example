# Copia este archivo a ".env" y completa los datos reales.
# .env NO se sube a Git (ver .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=monit_servers
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# Para scripts/cargar_offline_remoto.py -- reusa el acceso SSH que ya tiene el
# usuario del backend en DEVELOP (ya tiene permiso de escritura en pendientes_offline/).
DEVELOP_HOST=192.168.192.205
DEVELOP_SSH_PORT=22
DEVELOP_SSH_USER=tu_usuario
DEVELOP_SSH_PASSWORD=tu_password
DEVELOP_REMOTE_PATH=/opt/quantum/monit-servers-v2/ingesta/pendientes_offline
DEVELOP_API_URL=http://192.168.192.205:8000
