[Unit]
Description=Relay de datos de companeros - Monit_Servers_V2 (recolecta de otros servidores de este sitio)
After=network.target

[Service]
# Cambia 'quantum' por el usuario real del servidor
User=quantum

# Cambia la ruta al directorio donde clonaste el repositorio
WorkingDirectory=/home/quantum/check/monit_servers_v2/relay

# Ruta completa al python3 y al script. A diferencia del colector (stdlib
# puro), el relay necesita 'paramiko'/'pyyaml' instalados -- si el servidor
# usa conda y esos paquetes solo quedaron visibles ahi (no en el python3 del
# sistema), apunta ExecStart al python3 de conda en vez de /usr/bin/python3
# (verifica antes con: <python3_elegido> -c "import paramiko, yaml").
ExecStart=/usr/bin/python3 /home/quantum/check/monit_servers_v2/relay/relay.py

# Si el servicio falla, reiniciarlo automaticamente despues de 30 segundos
Restart=on-failure
RestartSec=30

# OJO: no apuntar StandardOutput/StandardError a relay.log. systemd crea ese
# archivo el mismo como root (antes de bajar privilegios al User= de arriba)
# si no existe -- y relay.py tambien lo abre por su cuenta via
# logging.basicConfig(), como 'quantum', lo que choca con el dueno root y
# tumba el servicio en un loop de reinicio. relay.py ya maneja su propio
# log; los logs del sistema quedan en el journal:
# journalctl -u monit_servers_v2_relay.service

[Install]
WantedBy=multi-user.target
