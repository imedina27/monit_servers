[Unit]
Description=Monitor de Temperaturas V2 (Monit_Servers_V2 - no confundir con el servicio viejo 'monit_servers')
After=network.target

[Service]
# Cambia 'quantum' por el usuario real del servidor
User=quantum

# Cambia la ruta al directorio donde clonaste el repositorio
WorkingDirectory=/home/quantum/check/monit_servers_v2/colector_ubuntu

# Ruta completa al python3 y al script
ExecStart=/usr/bin/python3 /home/quantum/check/monit_servers_v2/colector_ubuntu/monitor.py

# Si el servicio falla, reiniciarlo automaticamente despues de 10 segundos
Restart=on-failure
RestartSec=10

# OJO: no apuntar StandardOutput/StandardError a monitor.log. systemd crea
# ese archivo el mismo como root (antes de bajar privilegios al User= de
# arriba) si no existe -- y monitor.py tambien lo abre por su cuenta via
# logging.basicConfig(), como 'quantum', lo que choca con el dueno root y
# tumba el servicio en un loop de reinicio. monitor.py ya maneja su propio
# log; los logs del sistema (crashes no capturados, etc.) quedan en el
# journal: journalctl -u monit_servers_v2.service

[Install]
WantedBy=multi-user.target
